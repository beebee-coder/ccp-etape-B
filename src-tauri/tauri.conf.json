{
  "productName": "CCP-Etape-B",
  "version": "0.1.0",
  "identifier": "com.ccp.etape-b",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next"
  },
  "app": {
    "windows": [
      {
        "title": "CCP-Etape-B",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "fr-FR",
        "upgradeCode": "12345678-1234-1234-1234-123456789012"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "all": true,
      "scope": {
        "allow": [
          "$APPDATA/CCP-Etape-B/**",
          "$APPDATA/CCP-Etape-B/*"
        ],
        "deny": [
          "**"
        ]
      }
    }
  }
}
