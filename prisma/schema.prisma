generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(uuid())
  firstName            String?
  lastName             String?
  password             String
  email                String                 @unique
  approved             Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  lastSyncAt           DateTime?
  role                 Role                   @default(user)
  image                String?
  knowledge_items      knowledge_items[]
  procedure_executions procedure_executions[]
  procedures           Procedure[]

  @@map("users")
}

model Procedure {
  id                   String                 @id @default(uuid())
  code                 String                 @unique
  title                String
  description          String?
  category             String
  criticality          String                 @default("NORMAL")
  status               String                 @default("DRAFT")
  prerequisites        Json?
  steps                Json
  authorId             String
  lastExecutedAt       DateTime?
  executionCount       Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  subcategory          String?
  department           String?
  version              String?
  parameters           Json?
  postExecution        Json?
  metadata             Json?
  mediaLibrary         Json?
  procedure_alarms     procedure_alarms[]
  procedure_documents  procedure_documents[]
  procedure_executions procedure_executions[]
  procedure_media      procedure_media[]
  procedure_versions   procedure_versions[]
  users                User                   @relation(fields: [authorId], references: [id])

  @@map("procedures")
}

model chat_messages {
  id             String   @id
  conversationId String
  userId         String
  role           String
  content        String
  provider       String?
  timestamp      DateTime @default(now())
  media          Json?
  procedureId    String?
  source         String?
  clientId       String?

  @@unique([conversationId, userId, clientId])
  @@index([conversationId, userId])
}

model knowledge_items {
  id        String   @id
  userId    String
  type      String
  title     String
  question  String?
  answer    String?
  tags      String[]
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  content   String?
  users     User     @relation(fields: [userId], references: [id])
}

model procedure_alarms {
  id          String    @id
  procedureId String
  code        String
  type        String
  severity    String
  description String
  remedy      Json
  condition   String
  triggeredAt DateTime?
  resolvedAt  DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  procedures  Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

model procedure_documents {
  id          String    @id
  procedureId String
  title       String
  type        String
  url         String
  caption     String?
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  procedures  Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

model procedure_executions {
  id            String    @id
  procedureId   String
  operatorId    String
  startTime     DateTime? @default(now())
  endTime       DateTime? @default(now())
  status        String    @default("COMPLETED")
  stepsStatus   Json?
  totalDuration Int?      @default(0)
  currentStep   Int?
  alarms        Json?
  fallbacks     Json?
  events        Json?
  signature     String?
  users         User      @relation(fields: [operatorId], references: [id])
  procedures    Procedure @relation(fields: [procedureId], references: [id])
}

model procedure_field_templates {
  id          String   @id
  name        String
  type        String
  description String?
  options     Json?
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model procedure_media {
  id           String    @id
  procedureId  String
  kind         String
  source       String
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  mimeType     String
  fileSize     Int?
  duration     Float?
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())
  createdBy    String
  procedures   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

model procedure_versions {
  id          String    @id
  procedureId String
  version     String
  changes     String
  snapshot    Json
  createdAt   DateTime  @default(now())
  createdBy   String
  procedures  Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
}

enum Role {
  admin
  chef_de_bloc
  chef_de_quart
  
  user
}

model GuardrailRule {
  id        String   @id @default(uuid())
  section   String   @default("general")
  rule      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guardrail_rules")
  @@index([section])
  @@index([isActive])
}
