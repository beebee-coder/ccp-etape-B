{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "npx tsx src/lib/db/migrate.ts",
    "db:sql-seed": "npx tsx src/lib/db/seed.ts",
    "db:sqlite": "npm run db:sqlite:migrate && npm run db:sqlite:seed",
    "db:sqlite:migrate": "cross-env DATA_PROVIDER=sqlite npx tsx src/lib/db/migrate.ts",
    "db:sqlite:seed": "cross-env DATA_PROVIDER=sqlite npx tsx src/lib/db/seed.ts",
    "setup:tauri": "powershell -ExecutionPolicy Bypass -File scripts/setup-tauri.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:msi": "tauri build --bundles msi",
    "tauri:build:exe": "tauri build --bundles nsis",
    "tauri:build:all": "tauri build --bundles all",
    "restore:local-db": "npx tsx scripts/restore-local-db.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.2.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^2.0.0",
    "@google/generative-ai": "^0.24.1",
    "@hello-pangea/dnd": "^16.6.0",
    "@hookform/resolvers": "^3.9.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tauri-apps/api": "^2.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq-sdk": "^1.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "next": "14.2.35",
    "pg": "^8.22.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.0",
    "shadcn": "^4.16.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
