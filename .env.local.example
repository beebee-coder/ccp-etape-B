# Environment variables template for NexaFlow
# Copy this file to .env.local and fill in the values

# Authentication
AUTH_ADMIN_FIRST_NAME=admin@visionode.local
AUTH_ADMIN_LAST_NAME=your_admin_last_name
AUTH_ADMIN_PASSWORD=admin123
AUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# AI Providers (optional)
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# GitHub Integration (optional)
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=your_github_owner
GITHUB_REPO=your_github_repo

# Database
# Provider: "neon" for PostgreSQL cloud, "sqlite" for SQLite local (Tauri desktop)
DATA_PROVIDER=neon
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# SQLite local (Tauri desktop client)
SQLITE_DB_PATH=./.local-db/visionode.sqlite

# Vector Database (optional)
CHROMA_URL=http://127.0.0.1:8000
CHROMA_DB_PATH=./chroma-data
WEAVIATE_URL=your_weaviate_url
WEAVIATE_API_KEY=your_weaviate_api_key

  # Storage (optional)
  BLOB_READ_WRITE_TOKEN=your_blob_token_here

  # API Configuration
  NEXT_PUBLIC_API_URL=http://localhost:3000
